# PostgreSQL — dados de projetos e usuários
# No Docker use o host do serviço (ex: postgres); local, use localhost.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/heroforce_db

# Redis — cache de leitura, blacklist de token (logout) e rate limit de login
# No Docker use REDIS_HOST=redis; local, use localhost.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MongoDB — trilha de auditoria (quem alterou o quê, quando)
# No Docker use mongo:27017; local, use localhost:27017.
MONGODB_URI=mongodb://localhost:27017/heroforce_audit

# JWT
JWT_SECRET=im-batman

# Server
NODE_ENV=development
PORT=3000
